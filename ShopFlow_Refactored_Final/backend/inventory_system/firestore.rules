rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{id}        { allow read, write: if request.auth != null; }
    match /users/{id}           { allow read, write: if request.auth != null; }
    match /orders/{id}          { allow read, write: if request.auth != null; }
    match /tags/{id}            { allow read, write: if request.auth != null; }
    match /carts/{id}           { allow read, write: if request.auth != null; }
    match /sales/{id}           { allow read, write: if request.auth != null; }
    match /approvals/{id}       { allow read, write: if request.auth != null; }

    match /system_a_users/{id}      { allow read, write: if request.auth != null; }
    match /system_a_orders/{id}     { allow read, write: if request.auth != null; }
    match /system_b_products/{id}   { allow read, write: if request.auth != null; }
    match /system_b_sellers/{id}    { allow read, write: if request.auth != null; }
    match /system_b_tags/{id}       { allow read, write: if request.auth != null; }
    match /system_b_sales/{id}      { allow read, write: if request.auth != null; }
    match /system_b_approvals/{id}  { allow read, write: if request.auth != null; }

  }
}
